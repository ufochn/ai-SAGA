# ============================================================
# AI-SAGA 环境变量配置模板（可安全提交到仓库）
# 复制本文件为 .env 并填入真实值：
#   cp .env.example .env
# .env 已被 .gitignore 忽略，请勿将真实密钥提交到 GitHub。
# ============================================================

# 开发模式：true 时不接真实 Apple/Google OAuth，用本地设备 ID 作为测试账号
# （配合服务器 DEV_MODE=1 使用，仅用于联调，发布时务必移除或置为 false）
DEV_MODE=false

# 审核服务器地址（发送到服务器后再转 Dify + AWS Guard 审核）
AUDIT_API_URL=http://YOUR_SERVER_IP:YOUR_PORT/api/audit-and-chat

# 小说生成地址（发送用户设定到服务器 → 转 Dify 工作流 → 返回小说正文）
# 不配置时自动由 AUDIT_API_URL 推导出同服务器的 /api/generate-story
STORY_API_URL=http://YOUR_SERVER_IP:YOUR_PORT/api/generate-story

# 设备注册地址（用于获取审核签名令牌）
REGISTER_API_URL=http://YOUR_SERVER_IP:YOUR_PORT/api/register

# ---- 轻授权登录配置 ----
# Android：Google OAuth Web Client ID（用于 Google Sign-In）
# 需要先在 Google Cloud Console 创建 OAuth 2.0 客户端
GOOGLE_CLIENT_ID=

# iOS：Sign in with Apple 的 Service ID 与重定向 URI
# 需要先在 Apple Developer 配置 Sign in with Apple 能力
APPLE_SERVICE_ID=
APPLE_REDIRECT_URI=

# ---- Web 临时演示令牌（仅 Web 调试/演示用）----
# Chrome 等浏览器没有安全硬件通道，需用本令牌放行 web 运行：
#   - 留空 = 本地调试默认放行（不设门槛）
#   - 设置值 = 打开网页时需追加 ?demo_token=<该值>
# 该令牌是「临时调试放行」，非真实安全机制；请勿用于公开部署。
WEB_DEMO_CODE=

# ---- RAG 记忆检索（服务器侧，嵌入 API：当前 Jina v3，可切回 HF bge-m3）----
# 小说正文每章切块(600/100, 结尾倒推600)后经嵌入 API（Jina）编码；
# 每次用户行动指引做双通道检索（名字精确子串 + 语义 cosine ≥0.65），命中注入整章。
# 这些是【服务器】环境变量（部署时注入到服务器/容器），客户端无需配置。
# 未配置 HF_TOKEN 时服务器 RAG 优雅降级，不影响原有生成流程。
# 变量名沿用 HF_*（历史命名），实为"嵌入 API 配置"，_embed_texts 自动适配两种格式。
# HF_TOKEN=jina_xxxxxxxxxxxxxxxxxxxx
# EMBED_MODEL=jina-embeddings-v3
# HF_EMBED_URL=https://api.jina.ai/v1/embeddings
# RAG_CHUNK_TOKENS=600
# RAG_CHUNK_OVERLAP=100
# RAG_TOP_K=3
# RAG_SEMANTIC_THRESHOLD=0.65
# RAG_RETRIEVE_TIMEOUT=3
# RAG_MAX_INFLIGHT=5
# HF_MAX_CONNECTIONS=50
# RAG_BACKFILL_EVERY=5
# RAG_BACKFILL_BATCH=5
